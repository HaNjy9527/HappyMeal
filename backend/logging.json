{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "()": "uvicorn.logging.DefaultFormatter",
      "fmt": "%(levelprefix)s %(message)s",
      "use_colors": null
    },
    "json": {
      "()": "app.core.logging_filters.JsonFormatter"
    },
    "access": {
      "()": "uvicorn.logging.AccessFormatter",
      "fmt": "%(levelprefix)s %(client_addr)s - \"%(request_line)s\" %(status_code)s",
      "use_colors": null
    }
  },
  "filters": {
    "health_access_filter": {
      "()": "app.core.logging_filters.HealthAccessLogFilter"
    },
    "request_context_filter": {
      "()": "app.core.logging_filters.RequestContextFilter"
    }
  },
  "handlers": {
    "default": {
      "class": "logging.StreamHandler",
      "formatter": "default",
      "stream": "ext://sys.stderr"
    },
    "access": {
      "class": "logging.StreamHandler",
      "formatter": "access",
      "stream": "ext://sys.stdout",
      "filters": ["health_access_filter"]
    },
    "auth": {
      "class": "logging.StreamHandler",
      "formatter": "json",
      "stream": "ext://sys.stdout",
      "filters": ["request_context_filter"]
    }
  },
  "loggers": {
    "app.auth": {
      "handlers": ["auth"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn": {
      "handlers": ["default"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "level": "INFO"
    },
    "uvicorn.access": {
      "handlers": ["access"],
      "level": "INFO",
      "propagate": false
    }
  }
}
